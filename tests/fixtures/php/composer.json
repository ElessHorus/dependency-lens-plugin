{
    "name": "acme/demo",
    "description": "Fixture for the Composer parser",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "monolog/monolog": "^3.0",
        "symfony/console": "~6.2",
        "foo/dev": "dev-main",
        "bar/alias": "dev-main as 1.0.x-dev",
        "baz/stable": "1.2.*",
        "qux/flag": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "composer-plugin-api": "^2.0",
        "lib-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "Acme\\Demo\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "replace": {
        "acme/old": "self.version"
    },
    "suggest": {
        "ext-redis": "For caching"
    }
}
